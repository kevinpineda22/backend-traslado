# =============================================================================
# backend-traslado — variables de entorno
#
# Copiá este archivo a `.env` y completá los valores. En Vercel van cargadas en
# Settings → Environment Variables del proyecto.
#
# Las marcadas OBLIGATORIA matan el proceso al arrancar si faltan
# (`process.exit(1)` en src/config/). El resto tiene default y se puede omitir:
# el default está escrito al lado, así que este archivo también sirve de
# documentación de qué pasa si no la ponés.
# =============================================================================

# ── OBLIGATORIAS ─────────────────────────────────────────────────────────────
# Sin estas cuatro el backend no arranca (src/config/supabase.js, connekta.js).

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Connekta / SIESA. `CONNEKTA_BASE_URL` termina en /api/connekta/v3 — el módulo
# de stock deriva de acá el host raíz para las consultas estándar.
CONNEKTA_BASE_URL=https://servicios.siesacloud.com/api/connekta/v3
CONNEKTA_ID_COMPANIA=7375
CONNI_KEY=
CONNI_TOKEN=

# ── ⛔ NO PONER EN PRODUCCIÓN ────────────────────────────────────────────────
# TRASLADOS_SANDBOX=true corta correo Y escritura a SIESA. El sistema se ve
# funcionando —los despachos cierran, los estados avanzan— y en silencio deja de
# avisarle a compras y de mover inventario. Hay una guarda: con
# NODE_ENV=production se ignora y grita en los logs (src/config/sandbox.js).
# No confíes en la guarda: no la pongas.
# TRASLADOS_SANDBOX=true
#
# Desvía TODOS los correos a inventarios. Sirve para revisar maquetado, no para
# producción — compras y despachos dejarían de recibir lo suyo.
# TRASLADOS_MAIL_MODO_PRUEBA=true

# ── Correo (SMTP) ────────────────────────────────────────────────────────────
# Sin EMAIL_USER y EMAIL_PASS el envío queda deshabilitado en silencio: el
# sistema sigue andando pero nadie recibe el cierre de recolección.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.office365.com   # default: smtp.office365.com
EMAIL_PORT=587                  # default: 587
EMAIL_SECURE=false              # false para 587 (STARTTLS)

# Destinatarios. Listas separadas por coma.
TRASLADOS_MAIL_COMPRAS=
TRASLADOS_MAIL_INVENTARIOS=
TRASLADOS_MAIL_DESPACHOS=
TRASLADOS_MAIL_MANIFIESTO=
TRASLADOS_MAIL_LOGO_URL=

# ── Consultas Connekta (registradas) ─────────────────────────────────────────
CONNEKTA_QUERY_TRASLADOS=merkahorro_traslados_dev  # default: merkahorro_traslados_dev
CONNEKTA_TAM_PAG=1000            # default: 1000
CONNEKTA_CONCURRENCIA=3          # default: 3
CONNEKTA_MAX_INTENTOS=4          # default: 4

# Consulta del tránsito. SIN ESTA, la lectura del estado en SIESA LANZA — es a
# propósito: "no existe la entrada" es la respuesta que autoriza a crear una
# segunda, así que no se adivina. Tiene que terminar en
# `ORDER BY <llave> OFFSET 0 ROWS` o paginar saltea filas.
SIESA_CONSULTA_TRANSITO=
SIESA_CONSULTA_TRANSITO_TTL_MS=30000   # default: 30000

# ── Stock en vivo del despachador ────────────────────────────────────────────
# Usa la consulta ESTÁNDAR de SIESA `API_v2_Inventarios_InvFecha`, que se
# autoriza APARTE de las consultas registradas. Si Connekta la desactiva, acá
# llega un 401 y el resto del módulo sigue andando perfecto — pasó el 2026-09-04
# y el panel mostró todo en cero durante un despacho entero.
#
# Estas dos permiten apuntar SOLO esta consulta a otra credencial, sin tocar la
# que usan el snapshot, las requisiciones y el tránsito. Si no están, cae a
# CONNEKTA_KEY|CONNI_KEY / CONNEKTA_TOKEN|CONNI_TOKEN.
# SIESA_STOCK_CONNI_KEY=
# SIESA_STOCK_CONNI_TOKEN=
SIESA_STOCK_TTL_MS=60000        # default: 60000 (1 min)
SIESA_STOCK_CONCURRENCIA=8      # default: 8

# ── Escritura a SIESA (requisiciones y ajustes) ──────────────────────────────
SIESA_IMPORTAR_URL=
SIESA_IMPORTAR_ID_DOCUMENTO=252844                      # default: 252844
SIESA_IMPORTAR_ID_SISTEMA=1                             # default: 1
SIESA_IMPORTAR_NOMBRE_DOCUMENTO=
SIESA_IMPORTAR_CO=
SIESA_IMPORTAR_CO_POR_SEDE=      # JSON {sede: co}; override del mapa de flujos.js

# Ajuste de inventario automático ante el rechazo 470 "sin cantidad disponible".
SIESA_AJUSTE_AUTO=               # "true" para prender
SIESA_AJUSTE_ID_DOCUMENTO=250295                        # default: 250295
SIESA_AJUSTE_NOMBRE_DOCUMENTO=AJUSTE_DESARROLLO_REQUISICIONES
SIESA_AJUSTE_CONSULTA_COSTO=
SIESA_AJUSTE_UNIDAD_NEGOCIO=
SIESA_AJUSTE_UNIDAD_MEDIDA=

# Verificación de la entrada en tránsito ("1" por default = prendida).
SIESA_ENTRADA_VERIFICAR=1
# "true" manda SOLO la salida y no encadena la entrada.
SIESA_SOLO_SALIDA=

# ── Snapshot (cron cada 15 min, GitHub Actions) ──────────────────────────────
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=                     # "owner/repo"
GITHUB_WORKFLOW=snapshot-refresh.yml   # default: snapshot-refresh.yml
GITHUB_REF_SNAPSHOT=main               # default: main
SNAPSHOT_MIN_COMPLETITUD=0.95    # default: 0.95
SNAPSHOT_MIN_REGRESION=0.8       # default: 0.8
SNAPSHOT_GRACIA_PRUNE_MIN=180    # default: 180 (minutos)

# ── Crons y API de integraciones ─────────────────────────────────────────────
CRON_SECRET=
# Alias viejo de CRON_SECRET: se lee solo si CRON_SECRET no está. No agregues
# uno nuevo acá — es compatibilidad, no configuración.
REFRESH_TOKEN=
# API keys de los consumidores de /api/integraciones/v1/novedades.
# Formato: "consumidor:clave" separados por coma.
INTEGRACIONES_API_KEYS=

# ── Varios ───────────────────────────────────────────────────────────────────
PORT=3001
ALERTAS_GRACIA_AUDITOR_HORAS=
