{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/siesa/requisiciones/reintentar",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/alertas/barrer",
      "schedule": "*/10 * * * *"
    }
  ]
}
